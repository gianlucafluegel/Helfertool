generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GESCHAEFTSSTELLE
  STUFENLEITER
  FUNKTIONAER
  MITGLIED
}

enum ShiftArea {
  HELFER
  FUNKTIONAER
}

enum EventType {
  GAME
  EXTERNAL
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  POSTPONED
}

enum SignupPayoutType {
  HELFERKONTINGENT
  PAUSCHALE
  BARBEZUG
}

enum SignupStatus {
  CONFIRMED
  CANCELLED
}

enum MailTemplateKey {
  SIGNUP_CONFIRMATION
  REMINDER_UNFILLED
  ACCOUNT_SETUP
  PASSWORD_RESET
}

enum EmailStatus {
  SENT
  FAILED
}

enum AuthTokenPurpose {
  ACCOUNT_SETUP
  PASSWORD_RESET
}

// Nachwuchs (U9-U21) and Aktivmannschaften (3. Liga, 4. Liga, SWHL B, SWHL C,
// ...) come from two separate source systems/exports, each with their own
// Kontakt-ID numbering — the same number can legitimately refer to two
// different people. This is what disambiguates them: Member's uniqueness
// key is (Kontakt-ID, Kategorie), not Kontakt-ID alone. Deliberately coarser
// than the exact Stufe/Team, so a yearly Stufe change (U14 -> U16, or
// 3. Liga -> 4. Liga) still matches the same Member on re-import — only a
// cross-category collision is what gets told apart.
enum MemberCategory {
  NACHWUCHS
  AKTIV
}

model Season {
  id         String    @id @default(cuid())
  label      String    @unique
  startDate  DateTime
  endDate    DateTime
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  events  Event[]
  archive SeasonArchive?
}

// A frozen snapshot of an archived Season's entire content (Mitglieder,
// Helfereinsätze inkl. ShiftSlots/Signups), taken right before its live rows
// are wiped to make room for the new season's fresh import. `data` is
// self-contained (denormalized names, not live FK ids) so it stays readable
// even after the catalog data it referenced changes years later.
model SeasonArchive {
  id          String   @id @default(cuid())
  seasonId    String   @unique
  seasonLabel String
  archivedAt  DateTime @default(now())
  data        Json

  season Season @relation(fields: [seasonId], references: [id])
}

model AgeGroup {
  id                     String          @id @default(cuid())
  name                   String          @unique
  sortOrder              Int             @default(0)
  isActive               Boolean         @default(true)
  triggersBarbezugChoice Boolean         @default(false)
  // Nachwuchs (U9-U21) vs. Aktivmannschaften (3. Liga, 4. Liga, SWHL B, ...) —
  // see MemberCategory. Defaults to NACHWUCHS so the existing catalog rows
  // don't need a manual backfill; Aktiv rows get tagged explicitly whenever
  // they're added to the catalog.
  category               MemberCategory  @default(NACHWUCHS)

  shiftSlotRestrictions   ShiftSlotAgeGroup[]
  stufenleiterAssignments StufenleiterAssignment[]
  members                 Member[]
}

model Location {
  id       String  @id @default(cuid())
  name     String  @unique
  address  String?
  isActive Boolean @default(true)

  events Event[]
}

model Activity {
  id                   String     @id @default(cuid())
  name                 String     @unique
  defaultArea          ShiftArea?
  requiresPayoutChoice Boolean    @default(false)
  isActive             Boolean    @default(true)

  shiftSlots ShiftSlot[]
}

// Members persist across seasons — archiving a season snapshots that
// season's Events/ShiftSlots/Signups (and a copy of each Member's stats at
// that moment) but never deletes Members or their logins; only the
// season-specific activity gets wiped. The yearly roster re-import updates
// existing Members in place (matched by externalContactId) and marks
// whoever's missing from the new file isActive: false (their login is
// deactivated too, but nothing is deleted — historical hours stay intact).
// ageGroupId is the member's own Team/Stufe (from the roster import) —
// separate from a Helfereinsatz's own Stufe-Einschränkung, but the same
// AgeGroup catalog.
model Member {
  id                String          @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  iban              String?
  externalContactId String?
  // Denormalized copy of the matched AgeGroup's category at import time.
  // Needed as a physical column so it can take part in the compound unique
  // constraint below (Prisma can't span a relation in @@unique). Nachwuchs
  // and Aktivmannschaften are two separate source systems with independent
  // Kontakt-ID numbering, so the same number can legitimately belong to two
  // different people — (externalContactId, category) is what tells them
  // apart, while still matching the same Member across a plain Stufe change
  // within one category (e.g. U14 -> U16) on the next yearly re-import.
  category          MemberCategory?
  ageGroupId        String?
  targetHours       Decimal         @default(0) @db.Decimal(5, 2)
  importBatchId     String?
  notes             String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  ageGroup AgeGroup? @relation(fields: [ageGroupId], references: [id])
  user     User?
  signups  Signup[]

  @@unique([externalContactId, category])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  // Exactly one login per Member (e.g. per child) — never shared across
  // several Members, so helper hours always resolve to a single unambiguous
  // account. Nullable because pure staff logins (Geschäftsstelle) need no
  // Member/hours profile at all.
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id])

  stufenleiterAssignments StufenleiterAssignment[]
  authTokens              AuthToken[]
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
}

model StufenleiterAssignment {
  id         String @id @default(cuid())
  userId     String
  ageGroupId String

  user     User     @relation(fields: [userId], references: [id])
  ageGroup AgeGroup @relation(fields: [ageGroupId], references: [id])

  @@unique([userId, ageGroupId])
}

model Event {
  id            String      @id @default(cuid())
  seasonId      String
  type          EventType
  title         String
  description   String
  locationId    String?
  startDateTime DateTime
  endDateTime   DateTime?
  status        EventStatus @default(SCHEDULED)
  externalRef   String?
  importBatchId String?
  // True for a manual Helferstunden-correction created directly on a
  // Member's page (Geschäftsstelle → Mitglieder). Its ShiftSlot/Signup count
  // toward hours exactly like any other, but it's deliberately excluded from
  // every Einsätze browsing/overview list — it's a bookkeeping entry, not a
  // real shift anyone can sign up for.
  isManualEntry Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())

  season     Season      @relation(fields: [seasonId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])
  shiftSlots ShiftSlot[]

  @@index([seasonId, startDateTime])
}

model ShiftSlot {
  id          String    @id @default(cuid())
  eventId     String
  activityId  String
  area        ShiftArea
  capacity    Int       @default(1)
  creditHours Decimal   @db.Decimal(4, 2)
  notes       String?
  deletedAt   DateTime?

  event                Event               @relation(fields: [eventId], references: [id])
  activity             Activity            @relation(fields: [activityId], references: [id])
  ageGroupRestrictions ShiftSlotAgeGroup[]
  signups              Signup[]

  @@index([eventId])
}

model ShiftSlotAgeGroup {
  id          String @id @default(cuid())
  shiftSlotId String
  ageGroupId  String

  shiftSlot ShiftSlot @relation(fields: [shiftSlotId], references: [id])
  ageGroup  AgeGroup  @relation(fields: [ageGroupId], references: [id])

  @@unique([shiftSlotId, ageGroupId])
}

model Signup {
  id               String           @id @default(cuid())
  shiftSlotId      String
  memberId         String
  ageGroupSnapshot String
  helperFirstName  String
  helperLastName   String
  helperEmail      String
  helperPhone      String?
  payoutType       SignupPayoutType @default(HELFERKONTINGENT)
  ibanSnapshot     String?
  status           SignupStatus     @default(CONFIRMED)
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime         @default(now())

  shiftSlot ShiftSlot @relation(fields: [shiftSlotId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id])

  @@index([shiftSlotId, status])
  @@index([memberId, status])
}

model MailTemplate {
  id        String          @id @default(cuid())
  key       MailTemplateKey @unique
  subject   String
  bodyText  String
  updatedAt DateTime        @updatedAt
}

model EmailLog {
  id           String          @id @default(cuid())
  templateKey  MailTemplateKey
  toEmail      String
  subject      String
  status       EmailStatus
  errorMessage String?
  sentAt       DateTime        @default(now())

  @@index([sentAt])
}

model ImportBatch {
  id               String   @id @default(cuid())
  source           String
  importedAt       DateTime @default(now())
  importedByUserId String?
  notes            String?
}
